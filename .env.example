# Kopieren nach .env und mit echten Werten füllen. .env wird NICHT commitet.

# Basis-URL, unter der der Server öffentlich erreichbar ist (für OAuth-Redirects).
BASE_URL=http://localhost:3000

# --- Google (Gmail, Kalender, Kontakte) ---
# Google Cloud Console -> APIs & Dienste -> Anmeldedaten -> OAuth-Client-ID (Webanwendung)
# Autorisierte Weiterleitungs-URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify ---
# developer.spotify.com/dashboard -> App erstellen
# Redirect URI: ${BASE_URL}/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube ---
# Google Cloud Console -> APIs & Dienste -> Anmeldedaten -> API-Schlüssel
# (YouTube Data API v3 muss für das Projekt aktiviert sein)
YOUTUBE_API_KEY=
