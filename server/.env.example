# ===== F.R.Ai.D.A.Y Einstellungen =====
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die .env-Datei NIE in GitHub hochladen und NIE in einen Chat kopieren.

# --- Pflicht ---
# Dein Claude-API-Schlüssel von https://console.anthropic.com
ANTHROPIC_API_KEY=

# Wird automatisch von "npm run passwort" ausgefüllt. Nicht von Hand eintragen.
PASSWORD_HASH=
# Zufälliger langer Text, wird vom Installationsskript erzeugt.
SESSION_SECRET=
# Geheimer Schlüssel, mit dem sich der Mac-Agent anmeldet (vom Skript erzeugt).
AGENT_TOKEN=
# Schlüssel für Siri-Kurzbefehle, Apple Watch und Gesundheitsdaten (vom Skript erzeugt).
SHORTCUT_TOKEN=

# --- Allgemein ---
PORT=3000
# 127.0.0.1 lässt Friday nur auf diesem Mac lauschen. iPhone & Co. kommen über Tailscale rein.
HOST=127.0.0.1
# Wie du angesprochen werden willst
USER_NAME=Kevin
# Deine Stadt für Wetter und Briefing
CITY=Berlin
TIMEZONE=Europe/Berlin
# Claude-Modell (Standard: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Wie gründlich Friday nachdenkt: low (schnell), medium, high
CLAUDE_EFFORT=low

# --- Stimme (optional) ---
# Ohne Eintrag nutzt Friday die kostenlose Stimme deines Geräts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Push-Nachrichten aufs iPhone (optional) ---
# App "ntfy" aufs iPhone laden, dort ein Thema abonnieren (z. B. friday-kevin-8f3k2).
# Nimm einen schwer zu erratenden Namen.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Morgenbriefing (optional) ---
# Uhrzeit im Format HH:MM, leer lassen zum Ausschalten
BRIEFING_TIME=07:00

# --- Telegram (optional) ---
# Bot bei @BotFather anlegen, Token hier eintragen.
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID. Schreib dem Bot "/id", er antwortet mit deiner ID.
TELEGRAM_CHAT_ID=

# --- Google (YouTube-Videos & Karten, optional) ---
# API-Schlüssel von console.cloud.google.com (YouTube Data API v3 aktivieren).
GOOGLE_API_KEY=
# --- Windy Live-Webcams (optional) ---
# Schlüssel von api.windy.com (Webcams API).
WINDY_API_KEY=

# --- Live-Schiffsverfolgung (optional) ---
# Kostenloser Schlüssel von https://aisstream.io (anmelden, API-Key erstellen).
# Ohne Eintrag zeigt das Lagezentrum keine Schiffe.
AISSTREAM_API_KEY=

# --- Smart Home über Home Assistant (optional) ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Updates ---
# GitHub-Repo, aus dem Friday neue Versionen holt (Besitzer/Name) und der Zweig.
UPDATE_REPO=Kevin-FRIDAY/F.R.Ai.D.A.Y
UPDATE_BRANCH=main
